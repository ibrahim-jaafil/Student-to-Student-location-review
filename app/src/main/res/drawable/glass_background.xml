<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#80FFFFFF" /> <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <item android:state_hovered="true">
        <shape>
            <solid android:color="#4DFFFFFF" /> <corners android:radius="28dp" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#33FFFFFF" /> <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>

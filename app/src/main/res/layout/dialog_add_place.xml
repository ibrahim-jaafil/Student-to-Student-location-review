<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/profile_card_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Add New Place"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etPlaceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_pill_bg"
        android:hint="Place Name"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="#1D1B20"
        android:textColorHint="#757575"
        android:textSize="14sp"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/etCampus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_pill_bg"
        android:hint="Campus"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="#1D1B20"
        android:textColorHint="#757575"
        android:textSize="14sp"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/etLocationType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_pill_bg"
        android:hint="Location Type (Food/Cafes/etc.)"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="#1D1B20"
        android:textColorHint="#757575"
        android:textSize="14sp"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/etPriceRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_pill_bg"
        android:hint="Price Range (e.g. 500)"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="#1D1B20"
        android:textColorHint="#757575"
        android:textSize="14sp"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rating"
        android:textColor="#49454F"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <RatingBar
        android:id="@+id/dialogRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:numStars="5"
        android:stepSize="1"
        android:isIndicator="false"
        android:progressTint="@color/stars_color"
        android:progressBackgroundTint="#757575"
        android:layout_marginVertical="10dp"
        />

    <Button
        android:id="@+id/btnSubmitPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/LightDarkSlate"
        android:text="Add Place"
        android:textColor="@color/white"
        app:cornerRadius="24dp"
        />

</LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:layout_marginBottom="350px"
        android:divider="@drawable/gap"
        android:showDividers="middle"



        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Your Campus"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="170dp"
            android:textSize="24sp"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:cornerRadius="50dp"
            android:text="Besiktas"
            style="@style/ActionButton"
            android:id="@+id/besiktasLoc"


            />
        <com.google.android.material.button.MaterialButton
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:cornerRadius="50dp"
            android:text="North"
            style="@style/ActionButton"
            android:id="@+id/NorthLoc"


            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:cornerRadius="50dp"
            android:text="Galata"
            style="@style/ActionButton"
            android:id="@+id/GalataLoc"

            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            app:cornerRadius="50dp"
            android:text="Dental"
            style="@style/ActionButton"
            android:id="@+id/DentalLoc"

            />






    </LinearLayout>




